@page "/reports"
@inject ReportService ReportSvc

<PageTitle>Отчёт</PageTitle>

<h1 class="h3 mb-3">Отчёт за период</h1>

<div class="card mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label small mb-1">С</label>
            <input type="date" class="form-control form-control-sm" @bind="from" />
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1">По</label>
            <input type="date" class="form-control form-control-sm" @bind="to" />
        </div>
        <div class="col-md-auto">
            <div class="btn-group btn-group-sm">
                <button class="btn btn-outline-secondary" @onclick="() => Preset(0)">Этот месяц</button>
                <button class="btn btn-outline-secondary" @onclick="() => Preset(-1)">Прошлый месяц</button>
                <button class="btn btn-outline-secondary" @onclick="Quarter">Квартал</button>
                <button class="btn btn-outline-secondary" @onclick="Year">Год</button>
            </div>
        </div>
        <div class="col-md-auto">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="rep" @bind="includeReposts" />
                <label class="form-check-label small" for="rep">Учитывать перепечатки чужих материалов</label>
            </div>
        </div>
        <div class="col-md-auto">
            <button class="btn btn-sm btn-primary me-1" @onclick="BuildAsync">Сформировать</button>
            <a class="btn btn-sm btn-success" href="@ExportUrl" download>Скачать Excel</a>
        </div>
    </div>
</div>

@if (data != null)
{
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="card text-center"><div class="card-body">
                <div class="display-6">@data.OwnCount</div>
                <div class="small text-muted">собственных материалов</div>
            </div></div>
        </div>
        <div class="col-md-4">
            <div class="card text-center"><div class="card-body">
                <div class="display-6">@data.DerivedCount</div>
                <div class="small text-muted">материалов других ресурсов на их основе</div>
            </div></div>
        </div>
        <div class="col-md-4">
            <div class="card text-center"><div class="card-body">
                <div class="display-6">@data.WithDerivedCount</div>
                <div class="small text-muted">собственных материалов получили перепечатки</div>
            </div></div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-4"><CountTable Title="По видам" Rows="data.ByType" /></div>
        <div class="col-md-4"><CountTable Title="По собственным ресурсам" Rows="data.ByOwnResource" /></div>
        <div class="col-md-4"><CountTable Title="Перепечатки по ресурсам" Rows="data.DerivedByResource" /></div>
    </div>

    <h2 class="h5">Материалы</h2>
    <table class="table table-sm align-middle">
        <thead>
        <tr>
            <th style="width: 6rem">Дата</th>
            <th>Заголовок</th>
            <th style="width: 6rem" class="text-center">Перепечаток</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var m in data.Materials)
        {
            <tr>
                <td class="small">@Msk.FormatDate(m.PublishedAt)</td>
                <td>
                    <a href="materials/@m.Id">@m.Title</a>
                    @if (m.Derived.Count > 0)
                    {
                        <ul class="small mb-0">
                            @foreach (var d in m.Derived)
                            {
                                <li><a href="@d.Url" target="_blank" rel="noopener">@d.Resource</a> — @d.Title</li>
                            }
                        </ul>
                    }
                </td>
                <td class="text-center">@m.Derived.Count</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private DateTime from, to;
    private bool includeReposts;
    private ReportData? data;

    private string ExportUrl => $"reports/export?from={from:yyyy-MM-dd}&to={to:yyyy-MM-dd}&reposts={includeReposts.ToString().ToLowerInvariant()}";

    protected override Task OnInitializedAsync()
    {
        Preset(-1);
        return BuildAsync();
    }

    private void Preset(int monthOffset)
    {
        var first = new DateTime(Msk.Now.Year, Msk.Now.Month, 1).AddMonths(monthOffset);
        from = first;
        to = first.AddMonths(1).AddDays(-1);
    }

    private void Quarter()
    {
        var now = Msk.Now;
        from = new DateTime(now.Year, (now.Month - 1) / 3 * 3 + 1, 1);
        to = from.AddMonths(3).AddDays(-1);
    }

    private void Year()
    {
        from = new DateTime(Msk.Now.Year, 1, 1);
        to = new DateTime(Msk.Now.Year, 12, 31);
    }

    private async Task BuildAsync() =>
        data = await ReportSvc.BuildAsync(new ReportOptions(from, to, includeReposts));
}
