{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5080",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=press;Username=press;Password=press"
  },
  "Auth": {
    "InitialAdmin": {
      "Login": "admin",
      "Password": "admin123"
    }
  },
  "Collection": {
    "Enabled": true
  },
  "Http": {
    "Proxy": {
      "Url": "",
      "UserName": "",
      "Password": "",
      "Domain": "",
      "UseDefaultCredentials": false
    }
  },
  "Vk": {
    "ServiceToken": ""
  },
  "Monitoring": {
    "LookbackDays": 60,
    "PrefilterThreshold": 0.2,
    "CandidateThreshold": 0.35,
    "MaxFetchesPerRun": 60,
    "KeepIrrelevantDays": 90
  }
}