# Пароль базы данных (обязательно)
POSTGRES_PASSWORD=change-me

# Первый пользователь приложения (используется только при создании пустой базы)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-too

# Порт приложения в локальной сети: http://сервер:5080
APP_PORT=5080

# Сервисный ключ ВКонтакте для сбора постов группы (необязательно)
VK_SERVICE_TOKEN=

# Прокси для выхода в интернет (если нужен), например http://proxy.local:3128
PROXY_URL=
PROXY_USER=
PROXY_PASSWORD=
